# ============================================================
# NUSA LEARN — Environment Variables
# ============================================================
# Untuk development lokal: copy file ini ke `.env` dan isi value
# Untuk production (Vercel): set di Project Settings → Environment Variables
# ============================================================

# ---------- DATABASE URL (PENTING!) ----------
#
# PRODUCTION (Vercel + Supabase PostgreSQL):
#   Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#   - Gunakan port 6543 (connection pooler, cocok untuk serverless Vercel)
#   - Dapatkan dari Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# DEV LOKAL (pilih salah satu):
#   A) Pakai Supabase juga (rekomendasi, sama dengan production):
#      DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
#   B) Pakai SQLite lokal (offline, ganti prisma/schema.prisma: provider = "sqlite"):
#      DATABASE_URL="file:./db/custom.db"

DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---------- ADMIN PASSWORD ----------
# Password untuk login ke menu Admin di Home → Admin
# UNTUK PRODUCTION: ganti dengan password kuat yang unik!
# Jangan pakai default — ganti dengan password yang aman.
ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_KUAT"

# ---------- Z.AI SDK (OPSIONAL) ----------
# z-ai-web-dev-sdk dipakai untuk NOVA AI hint (endpoint /api/hint)
# Default-nya pakai credential bawaan — biasanya tidak perlu di-set
# Kalau mau pakai key sendiri:
# ZAI_API_KEY="your-z-ai-api-key"
