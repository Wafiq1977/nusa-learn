# ============================================================
# NUSA LEARN — Environment Variables Example
# ============================================================
# Copy file ini ke `.env` untuk development lokal,
# atau set value-nya di Vercel → Project Settings → Environment Variables
# ============================================================

# ---------- DATABASE (PENTING!) ----------
# Untuk development lokal (SQLite):
DATABASE_URL="file:./db/custom.db"

# Untuk production di Vercel — gunakan PostgreSQL Supabase (gratis 500MB):
# 1. Buat project di https://supabase.com
# 2. Copy connection string dari Project Settings → Database → URI
# 3. Set di Vercel:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# (gunakan port 6543 = connection pooler, supaya cocok dengan serverless)

# ---------- ADMIN (PENTING!) ----------
# Password untuk login ke menu Admin (default: nusa-admin)
# GANTI dengan password kuat untuk production!
ADMIN_PASSWORD="nusa-admin"

# ---------- Z.AI SDK (OPSIONAL) ----------
# z-ai-web-dev-sdk dipakai untuk NOVA AI hint (endpoint /api/hint)
# Default-nya pakai credential bawaan — tidak perlu di-set
# Tapi kalau mau pakai key sendiri:
# ZAI_API_KEY="your-z-ai-api-key"

# ---------- NEXTAUTH (OPSIONAL, untuk fitur auth siswa/orang tua di masa depan) ----------
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="https://your-vercel-app.vercel.app"
