# ============================================================
# NUSA LEARN — .gitignore
# ============================================================

# ---------- Dependencies ----------
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Testing ----------
/coverage

# ---------- Next.js ----------
/.next/
/out/
/build

# ---------- Misc ----------
.DS_Store
*.pem

# ---------- Debug logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# ---------- Environment (PENTING! jangan commit) ----------
.env
.env.local
.env.*.local
# Allow .env.example sebagai template
!.env.example

# ---------- Vercel ----------
.vercel

# ---------- TypeScript ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Database lokal (SQLite dev sandbox) ----------
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# ---------- Sandbox-only files (jangan commit ke repo production) ----------
worklog.md
.zscripts/
.z-ai-config
.claude
local-*
prompt
test
skills/

# Folder sandbox yang tidak relevan untuk Vercel deployment
/download/
/examples/
/mini-services/
/tests/
Caddyfile

# ---------- Upload ----------
/upload/
